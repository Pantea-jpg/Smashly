{
  "name": "@tw/mobile",
  "version": "0.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@hookform/resolvers": "7.0.9",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "7.22.0",
    "@react-navigation/native": "7.5.2",
    "@react-navigation/native-stack": "7.21.1",
    "@sentry/react-native": "~8.28.1",
    "@stripe/stripe-react-native": "0.81.0",
    "@tanstack/react-query": "5.108.4",
    "@tw/contracts": "workspace:*",
    "@tw/i18n": "workspace:*",
    "@tw/money": "workspace:*",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-haptics": "~58.0.8",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.9",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "i18next": "27.2.7",
    "react": "19.3.0",
    "react-hook-form": "7.92.0",
    "react-i18next": "18.0.3",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "socket.io-client": "4.8.4",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@tw/config": "workspace:*",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/react": "~19.3.0",
    "jest": "30.5.2",
    "jest-expo": "~58.0.15",
    "test-renderer": "1.3.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "typecheck": "tsc -p tsconfig.json",
    "doctor": "expo-doctor",
    "test": "jest --coverage"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/test/setup.ts"
    ],
    "testMatch": [
      "<rootDir>/src/**/*.test.ts?(x)"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@react-navigation/.*|react-native-screens|react-native-safe-area-context|@tw/.*))"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.test.{ts,tsx}"
    ],
    "coverageReporters": [
      "text-summary"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80,
        "statements": 80,
        "functions": 70,
        "branches": 60
      }
    },
    "testTimeout": 20000
  }
}
