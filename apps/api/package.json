{
  "name": "@tw/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "dev:once": "tsx --env-file-if-exists=.env src/main.ts",
    "build": "node build.mjs",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "start:worker": "node --enable-source-maps dist/worker.js",
    "keys:generate": "node scripts/generate-jwt-key.mjs",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "storage:setup": "tsx --env-file-if-exists=.env scripts/setup-storage.ts",
    "simulate:ledger": "tsx scripts/simulate-ledger.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@aws-sdk/client-s3": "3.1176.0",
    "@aws-sdk/s3-request-presigner": "3.1176.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sentry/node": "11.18.0",
    "@tw/contracts": "workspace:*",
    "@tw/i18n": "workspace:*",
    "@tw/money": "workspace:*",
    "argon2": "0.45.2",
    "cors": "2.8.6",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "express-rate-limit": "8.7.5",
    "helmet": "8.3.0",
    "i18next": "27.2.7",
    "jose": "6.2.18",
    "nodemailer": "10.6.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prisma": "7.10.1",
    "rate-limit-redis": "6.0.2",
    "redis": "6.4.0",
    "socket.io": "4.8.4",
    "stripe": "23.2.0",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.2",
    "@tw/config": "workspace:*",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "esbuild": "0.28.2",
    "fast-check": "4.11.0",
    "pino-pretty": "13.2.0",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "vitest": "5.1.1"
  }
}
