# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
APP_VERSION=0.0.0-dev

# Matches infra/docker-compose.yml
DATABASE_URL=postgresql://tw:tw_local_password@localhost:5433/training_wallet?schema=public

# Comma-separated browser origins (future web admin). Leave empty for mobile-only.
CORS_ORIGINS=
TRUST_PROXY_HOPS=0
ENABLE_API_DOCS=true

# Shared rate-limit store (required in staging/production)
REDIS_URL=redis://localhost:6379
# Mailpit locally: UI at http://localhost:8025
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=Training Wallet <no-reply@localhost>
APP_LINK_BASE=trainingwallet://

# Generate with: pnpm --filter @tw/api keys:generate
JWT_KEY_ID=k1
JWT_PRIVATE_KEY=

# Seed (pnpm --filter @tw/api db:seed). Choose your own values; never reuse real passwords.
SEED_ADMIN_EMAIL=admin@trainingwallet.test
SEED_ADMIN_PASSWORD=
SEED_DEMO_USERS=false
SEED_DEMO_PASSWORD=

# Scratch database for migration drift checks (prisma migrate dev / diff)
SHADOW_DATABASE_URL=postgresql://tw:tw_local_password@localhost:5433/training_wallet_shadow

# S3-compatible storage (SeaweedFS from infra/docker-compose.yml)
S3_ENDPOINT=http://localhost:8333
S3_REGION=eu-central-1
S3_BUCKET=training-wallet-dev
S3_ACCESS_KEY_ID=tw_s3
S3_SECRET_ACCESS_KEY=tw_s3_local_password
S3_FORCE_PATH_STYLE=true

# Stripe (test mode). All three keys together, or none: without them online top-ups return
# PAYMENTS_UNAVAILABLE and the app falls back to cash only. Production refuses sk_test_ keys.
# Webhook secret: `stripe listen --forward-to localhost:3000/api/v1/webhooks/stripe` prints it.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Local only: point the SDK at stripe-mock (pnpm db:up starts it on 12111). Refused when deployed.
# STRIPE_SECRET_KEY=sk_test_mock
# STRIPE_PUBLISHABLE_KEY=pk_test_mock
# STRIPE_WEBHOOK_SECRET=whsec_local_mock
# STRIPE_API_URL=http://localhost:12111
# stripe-mock returns the same canned PaymentIntent id every time, so only the first top-up per
# database works against it; use real Stripe test keys for repeated manual testing.

# Push notifications (APNs, token-based .p8 auth). All three together, or none: without them the
# worker logs each push instead of sending it. Apple Developer → Certificates, IDs & Profiles →
# Keys → "+" with "Apple Push Notifications service". APNS_PRIVATE_KEY is the .p8 file, base64:
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("AuthKey_XXXXXXXXXX.p8"))
# Development builds use the sandbox; TestFlight and App Store builds use production.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=com.trainingwallet.app
APNS_ENVIRONMENT=sandbox

# Monitoring (Sentry, EU region: create the project at https://de.sentry.io). Required in
# production; without it alerts (reconciliation mismatch, failed jobs, payment review) only
# reach the logs.
SENTRY_DSN=

# Reject new passwords found in data breaches (Have I Been Pwned, k-anonymity: only 5
# characters of the password's SHA-1 leave the server). Fails open when the service is down.
# Set to false to work fully offline.
PASSWORD_BREACH_CHECK=true
